modules = ["python-3.11"]
[agent]
expertMode = true
integrations = ["python_openai:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dashboard Dev Server"

[[workflows.workflow]]
name = "Dashboard Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -c \"import sys, os; sys.path.insert(0, '/root/project'); os.chdir('/root/project'); from backend.app import app; app.run(host='0.0.0.0', port=5000, debug=False, use_reloader=False)\""
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
